# R session state
.Rhistory
.RData
.Rapp.history
.Ruserdata
.Renviron
.Rproj.user/

# IDE / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
.claude/settings.local.json

# External tool sources (install vsearch / BLAST+ on PATH instead)
*.tar.gz

# renv (no longer used in this project; library was 539 MB)
renv/
renv.lock

# targets stores: per-store .gitignore files already keep meta/meta and drop
# objects/. Do not blanket-ignore store_*/ here or those rules get bypassed.
# Smoke-test stores (the *_mini projects of _targets.yaml) are not tracked.
store_*_mini/

# Quarto project outputs and the inter-chapter cache of analysis/
analysis/_cache/
analysis/_freeze/
analysis/_output/
analysis/*_files/
analysis/*.html

# Data — ~10 GB on disk. Only metadata CSVs are tracked
# (data/data_raw/metadata/* stays in by default).
data/data_raw/refseq/
data/data_raw/rawseq/
data/data_raw/rawseq_endophyte/
data/data_raw/mock_hleap2021/
data/data_raw/fake_ref/
data/data_raw/insilico/
# Raw reads of the D1c biological datasets, one folder per config.R::bio_datasets
# entry. A glob rather than a line per dataset: the table is meant to grow, and
# each new entry would otherwise be a silent multi-MB commit.
data/data_raw/rawseq_*/
data/data_intermediate/
data/data_final/

# Figures are regenerated by analysis/benchmark.qmd (decision 2026-09-10)
figures/*
!figures/.gitkeep

# Editor / temp
*.swp
*~
*.bak
*.tmp

# Rendered docs (regenerated with quarto from docs/*.md)
docs/*.html
docs/*_files/
